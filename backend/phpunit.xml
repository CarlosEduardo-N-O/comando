<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="storage/framework/testing/.phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Banco de testes isolado (compose.test.yaml). tests/TestCase.php recusa qualquer outro. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:dGVzdGVzLXNvbWVudGUtbmFvLXVzYXItZW0tcHJvZCE=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres-test" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="comando_test" force="true"/>
        <env name="DB_USERNAME" value="comando_test" force="true"/>
        <env name="DB_PASSWORD" value="somente-testes" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="ANEXOS_DISK" value="local" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="LOG_LEVEL" value="error" force="true"/>
    </php>
</phpunit>
