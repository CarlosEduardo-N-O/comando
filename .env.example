# =============================================================================
# Comando - configuração da instalação
# Copie para ".env" (veja o README) e ajuste os valores. NUNCA versione o .env.
# Backend, worker e scheduler recebem exatamente esta mesma configuração.
# =============================================================================

COMPOSE_PROJECT_NAME=comando
# Tag das imagens geradas localmente (use uma versão, ex.: 1.0.0, em atualizações)
COMANDO_TAG=local

# --- Aplicação ---------------------------------------------------------------
APP_NAME=Comando
APP_ENV=production
APP_DEBUG=false
# Gerada uma única vez pelo script docker/scripts/key.sh (Linux) ou key.ps1 (Windows). Não regenerar.
APP_KEY=
# Endereço público usado pelos usuários (inclua a porta, se houver)
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
# Fuso de EXIBIÇÃO (os horários são armazenados em UTC)
DISPLAY_TIMEZONE=America/Sao_Paulo

# Porta publicada pelo Nginx e interface de rede (0.0.0.0 = todas; 127.0.0.1 = só local)
WEB_PORT=8080
WEB_BIND=0.0.0.0

# --- Banco de dados (PostgreSQL local ou Amazon RDS) --------------------------
DB_CONNECTION=pgsql
# "postgres" quando usar compose.local-db.yaml; endpoint do RDS quando externo
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=comando
DB_USERNAME=comando
DB_PASSWORD=troque-por-uma-senha-forte
# disable | allow | prefer | require | verify-ca | verify-full (RDS: verify-full)
DB_SSLMODE=prefer
# Caminho DENTRO do container, ex.: /etc/comando/certs/global-bundle.pem
DB_SSLROOTCERT=

# --- Sessão e autenticação (Sanctum SPA) -------------------------------------
SESSION_DRIVER=database
# Minutos de inatividade até a sessão expirar
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
# true quando a aplicação for acessada por HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
# Hosts (com porta) de onde o navegador acessa a aplicação, separados por vírgula.
# Inclua o nome/IP do servidor, ex.: comando.empresa.com.br,10.0.0.15:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# Origens extras para CORS (somente desenvolvimento, ex.: http://localhost:5173)
CORS_ALLOWED_ORIGINS=

# --- Filas, cache, arquivos e logs -------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
ANEXOS_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# --- Desenvolvimento ---------------------------------------------------------
# Porta local do PostgreSQL exposta somente pelo compose.dev.yaml
DB_DEV_PORT=5433
